# Flight Travel Assistance - Environment Variables
# Copy this file to .env.local and fill in your values

# Site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://flighttravelassistance.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager (optional)
NEXT_PUBLIC_GTM_ID=

# Google Ads Conversion Tracking (optional)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=

# Note: Do NOT put Ringba dashboard URLs or API keys here.
# The tracking phone number is configured in src/lib/config.ts
